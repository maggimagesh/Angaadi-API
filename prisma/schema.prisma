generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model userDetails {
  id                   BigInt                @id @default(autoincrement())
  created_at           DateTime              @default(now()) @db.Timestamptz(6)
  firstName            String                @default("")
  lastName             String                @default("")
  emailId              String                @unique @default("") @db.VarChar
  password             String                @db.VarChar
  updated_at           DateTime?             @db.Timestamptz(6)
  preferredDepartments PreferredDepartment[]
  userPhysicalStats    userPhysicalStats[]

  @@map("userDetails")
}

model Gender {
  id          BigInt                @id @default(autoincrement())
  gender      String                @unique
  created_at  DateTime              @default(now()) @db.Timestamptz(6)
  updated_at  DateTime?             @db.Timestamptz(6)
  preferredBy PreferredDepartment[]

  @@map("gender")
}

model PreferredDepartment {
  id         BigInt       @id @default(autoincrement())
  userId     BigInt?
  genderId   BigInt?
  created_at DateTime     @default(now()) @db.Timestamptz(6)
  updated_at DateTime?    @db.Timestamptz(6)
  isActive   Int          @default(1) @db.SmallInt
  gender     Gender?      @relation(fields: [genderId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  user       userDetails? @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@map("preferredDepartment")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model userPhysicalStats {
  id          BigInt       @id @default(autoincrement())
  userId      BigInt?
  heightCm    Float?
  heightFt    Float?
  weightKg    Float?
  weightLb    Float?
  created_at  DateTime     @default(now()) @db.Timestamptz(6)
  updated_at  DateTime?    @db.Timestamptz(6)
  userDetails userDetails? @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)
}
