generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model userDetails {
  id                   BigInt                @id @default(autoincrement())
  created_at           DateTime              @default(now()) @db.Timestamptz(6)
  firstName            String                @default("")
  lastName             String                @default("")
  emailId              String                @unique @default("") @db.VarChar
  password             String                @db.VarChar
  updated_at           DateTime?             @db.Timestamptz(6)
  preferredDepartments PreferredDepartment[]
  userAgeGroups        UserAgeGroup[]
  userFitAttributes    userFitAttributes[]
  userPhysicalStats    userPhysicalStats[]

  @@map("userDetails")
}

model Gender {
  id          BigInt                @id @default(autoincrement())
  gender      String                @unique
  created_at  DateTime              @default(now()) @db.Timestamptz(6)
  updated_at  DateTime?             @db.Timestamptz(6)
  preferredBy PreferredDepartment[]

  @@map("gender")
}

model PreferredDepartment {
  id         BigInt       @id @default(autoincrement())
  userId     BigInt?
  genderId   BigInt?
  created_at DateTime     @default(now()) @db.Timestamptz(6)
  updated_at DateTime?    @db.Timestamptz(6)
  isActive   Int          @default(1) @db.SmallInt
  gender     Gender?      @relation(fields: [genderId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  user       userDetails? @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@map("preferredDepartment")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model userPhysicalStats {
  id          BigInt       @id @default(autoincrement())
  userId      BigInt?
  heightCm    Float?
  heightFt    Float?
  weightKg    Float?
  weightLb    Float?
  created_at  DateTime     @default(now()) @db.Timestamptz(6)
  updated_at  DateTime?    @db.Timestamptz(6)
  userDetails userDetails? @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)
}

model AgeGroup {
  id            BigInt         @id @default(autoincrement())
  ageRange      String         @unique
  minAge        Int?
  maxAge        Int?
  created_at    DateTime       @default(now()) @db.Timestamptz(6)
  updated_at    DateTime?      @db.Timestamptz(6)
  userAgeGroups UserAgeGroup[]

  @@map("ageGroup")
}

model UserAgeGroup {
  id         BigInt       @id @default(autoincrement())
  userId     BigInt?
  ageGroupId BigInt?
  created_at DateTime     @default(now()) @db.Timestamptz(6)
  updated_at DateTime?    @db.Timestamptz(6)
  isActive   Int          @default(1) @db.SmallInt
  ageGroup   AgeGroup?    @relation(fields: [ageGroupId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  user       userDetails? @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@map("userAgeGroup")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model fitAttribute {
  id                                                           Int                 @id(map: "fitattribute_pkey") @default(autoincrement())
  attributeName                                                String
  optionValue                                                  String              @db.VarChar(50)
  userFitAttributes_userFitAttributes_hipsIdTofitAttribute     userFitAttributes[] @relation("userFitAttributes_hipsIdTofitAttribute")
  userFitAttributes_userFitAttributes_shoulderIdTofitAttribute userFitAttributes[] @relation("userFitAttributes_shoulderIdTofitAttribute")
  userFitAttributes_userFitAttributes_thighsIdTofitAttribute   userFitAttributes[] @relation("userFitAttributes_thighsIdTofitAttribute")
  userFitAttributes_userFitAttributes_waistIdTofitAttribute    userFitAttributes[] @relation("userFitAttributes_waistIdTofitAttribute")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model userFitAttributes {
  id                                                      Int           @id(map: "userfitattributes_pkey") @default(autoincrement())
  userId                                                  BigInt
  shoulderId                                              Int?
  waistId                                                 Int?
  thighsId                                                Int?
  hipsId                                                  Int?
  created_at                                              DateTime?     @default(now()) @db.Timestamp(6)
  updated_at                                              DateTime?     @db.Timestamptz(6)
  isActive                                                Boolean       @default(true)
  fitAttribute_userFitAttributes_hipsIdTofitAttribute     fitAttribute? @relation("userFitAttributes_hipsIdTofitAttribute", fields: [hipsId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  fitAttribute_userFitAttributes_shoulderIdTofitAttribute fitAttribute? @relation("userFitAttributes_shoulderIdTofitAttribute", fields: [shoulderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  fitAttribute_userFitAttributes_thighsIdTofitAttribute   fitAttribute? @relation("userFitAttributes_thighsIdTofitAttribute", fields: [thighsId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  userDetails                                             userDetails   @relation(fields: [userId], references: [id], onUpdate: NoAction)
  fitAttribute_userFitAttributes_waistIdTofitAttribute    fitAttribute? @relation("userFitAttributes_waistIdTofitAttribute", fields: [waistId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}
