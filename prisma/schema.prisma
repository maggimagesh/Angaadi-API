generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model userDetails {
  id                   BigInt                @id @default(autoincrement())
  created_at           DateTime              @default(now()) @db.Timestamptz(6)
  firstName            String                @default("")
  lastName             String                @default("")
  emailId              String                @unique @default("") @db.VarChar
  password             String                @db.VarChar
  updated_at           DateTime?             @db.Timestamptz(6)
  UserShoeSize         UserShoeSize[]
  preferredDepartments PreferredDepartment[]
  userAgeGroups        UserAgeGroup[]
  userFitAttributes    userFitAttributes[]
  userPhysicalStats    userPhysicalStats[]

  @@map("userDetails")
}

model Gender {
  id          BigInt                @id @default(autoincrement())
  gender      String                @unique
  created_at  DateTime              @default(now()) @db.Timestamptz(6)
  updated_at  DateTime?             @db.Timestamptz(6)
  preferredBy PreferredDepartment[]

  @@map("gender")
}

model PreferredDepartment {
  id         BigInt       @id @default(autoincrement())
  userId     BigInt?
  genderId   BigInt?
  created_at DateTime     @default(now()) @db.Timestamptz(6)
  updated_at DateTime?    @db.Timestamptz(6)
  isActive   Int          @default(1) @db.SmallInt
  gender     Gender?      @relation(fields: [genderId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  user       userDetails? @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@map("preferredDepartment")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model userPhysicalStats {
  id          BigInt       @id @default(autoincrement())
  userId      BigInt?
  heightCm    Float?
  heightFt    Float?
  weightKg    Float?
  weightLb    Float?
  created_at  DateTime     @default(now()) @db.Timestamptz(6)
  updated_at  DateTime?    @db.Timestamptz(6)
  userDetails userDetails? @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)
}

model AgeGroup {
  id            BigInt         @id @default(autoincrement())
  ageRange      String         @unique
  minAge        Int?
  maxAge        Int?
  created_at    DateTime       @default(now()) @db.Timestamptz(6)
  updated_at    DateTime?      @db.Timestamptz(6)
  userAgeGroups UserAgeGroup[]

  @@map("ageGroup")
}

model UserAgeGroup {
  id         BigInt       @id @default(autoincrement())
  userId     BigInt?
  ageGroupId BigInt?
  created_at DateTime     @default(now()) @db.Timestamptz(6)
  updated_at DateTime?    @db.Timestamptz(6)
  isActive   Int          @default(1) @db.SmallInt
  ageGroup   AgeGroup?    @relation(fields: [ageGroupId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  user       userDetails? @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@map("userAgeGroup")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model fitAttribute {
  id                                                           Int                 @id(map: "fitattribute_pkey") @default(autoincrement())
  attributeName                                                String
  optionValue                                                  String              @db.VarChar(50)
  userFitAttributes_userFitAttributes_hipsIdTofitAttribute     userFitAttributes[] @relation("userFitAttributes_hipsIdTofitAttribute")
  userFitAttributes_userFitAttributes_shoulderIdTofitAttribute userFitAttributes[] @relation("userFitAttributes_shoulderIdTofitAttribute")
  userFitAttributes_userFitAttributes_thighsIdTofitAttribute   userFitAttributes[] @relation("userFitAttributes_thighsIdTofitAttribute")
  userFitAttributes_userFitAttributes_waistIdTofitAttribute    userFitAttributes[] @relation("userFitAttributes_waistIdTofitAttribute")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model userFitAttributes {
  id                                                      Int           @id(map: "userfitattributes_pkey") @default(autoincrement())
  userId                                                  BigInt
  shoulderId                                              Int?
  waistId                                                 Int?
  thighsId                                                Int?
  hipsId                                                  Int?
  created_at                                              DateTime?     @default(now()) @db.Timestamp(6)
  updated_at                                              DateTime?     @db.Timestamptz(6)
  isActive                                                Boolean       @default(true)
  fitAttribute_userFitAttributes_hipsIdTofitAttribute     fitAttribute? @relation("userFitAttributes_hipsIdTofitAttribute", fields: [hipsId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  fitAttribute_userFitAttributes_shoulderIdTofitAttribute fitAttribute? @relation("userFitAttributes_shoulderIdTofitAttribute", fields: [shoulderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  fitAttribute_userFitAttributes_thighsIdTofitAttribute   fitAttribute? @relation("userFitAttributes_thighsIdTofitAttribute", fields: [thighsId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  userDetails                                             userDetails   @relation(fields: [userId], references: [id], onUpdate: NoAction)
  fitAttribute_userFitAttributes_waistIdTofitAttribute    fitAttribute? @relation("userFitAttributes_waistIdTofitAttribute", fields: [waistId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model UserShoeSize {
  id          BigInt       @id @default(autoincrement())
  created_at  DateTime     @default(now()) @db.Timestamptz(6)
  userId      BigInt?
  shoeSizeId  Int?
  updated_at  DateTime?    @db.Timestamptz(6)
  isActive    Int?         @default(1) @db.SmallInt
  shoeSize    shoeSize?    @relation(fields: [shoeSizeId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  userDetails userDetails? @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model shoeSize {
  id           Int            @id(map: "shoesize_pkey") @default(autoincrement())
  size         Decimal        @db.Decimal(4, 1)
  width        String         @db.VarChar(20)
  created_at   DateTime?      @default(now()) @db.Timestamp(6)
  UserShoeSize UserShoeSize[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model categories {
  id           Int            @id(map: "products_pkey") @default(autoincrement())
  categoryname String         @db.VarChar(100)
  description  String         @db.VarChar(100)
  created_at   DateTime?      @default(now()) @db.Timestamp(6)
  slug         String?        @unique(map: "products_slug_key") @db.VarChar(150)
  badge        String?        @default("Shop Now") @db.VarChar(100)
  imageurl     String?
  displayorder Int?           @default(0)
  isactive     Boolean?       @default(true)
  icon         String?        @db.VarChar(10)
  productcount Int?           @default(0)
  updated_at   DateTime?      @default(now()) @db.Timestamp(6)
  isActive     Int?           @db.SmallInt
  productsdata productsdata[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model productsdata {
  id              Int         @id @default(autoincrement())
  categoryid      Int?
  productname     String      @db.VarChar(150)
  description     String?
  imageurl        String?
  badge           String?     @db.VarChar(50)
  price           Decimal     @db.Decimal(10, 2)
  oldprice        Decimal?    @db.Decimal(10, 2)
  ratingscount    Int?        @default(0)
  starrating      Decimal?    @default(0.0) @db.Decimal(2, 1)
  brand           String?     @db.VarChar(100)
  stock           Int?        @default(0)
  slug            String?     @unique @db.VarChar(150)
  discountpercent Int?
  freedelivery    Boolean?    @default(false)
  isactive        Boolean?    @default(true)
  created_at      DateTime?   @default(now()) @db.Timestamp(6)
  updated_at      DateTime?   @default(now()) @db.Timestamp(6)
  categories      categories? @relation(fields: [categoryid], references: [id], onDelete: Cascade, onUpdate: NoAction)
}
